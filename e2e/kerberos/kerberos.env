# Defaults of the Kerberos e2e test that do not depend on the KDC provider.
#
# bootstrap.sh sources this file after KRB_PROVIDER is resolved and before
# providers/$KRB_PROVIDER.sh, so provider defaults may refer to these variables.
# A value already set in the environment always wins.

# Realm of the KDC, the client krb5.conf and the module's Kerberos realm attribute.
: "${KRB_REALM:=EXAMPLE.ORG}"
# Host name of OpenAM as the browser sees it: SPN, [domain_realm] and --auth-server-allowlist.
: "${KRB_SPN_HOST:=openam.example.org}"
# SPN requested by the browser and curl; the service keytab is exported for it.
: "${KRB_SPN:=HTTP/$KRB_SPN_HOST}"
# Keytab location inside the OpenAM container.
: "${KRB_KEYTAB_PATH:=/usr/openam/http.keytab}"
# Address the KDC port is published on, and the KDC address in the client krb5.conf.
# Docker Desktop on macOS cannot publish port 88; use an unprivileged one there, e.g. 127.0.0.1:10088.
: "${KRB_KDC_CLIENT_ADDR:=127.0.0.1:88}"
# Kerberos user; with returnRealm=false it must match an OpenAM user.
: "${KRB_USER:=demo}"
# Names of the WindowsDesktopSSO module instance and of the chain Kerberos -> DataStore.
: "${KRB_MODULE_NAME:=Kerberos}"
: "${KRB_CHAIN_NAME:=KerberosChain}"
# OpenAM container that runs ssoadm and the Docker network it shares with the KDC.
: "${KRB_OPENAM_CONTAINER:=openam-idp}"
: "${KRB_DOCKER_NETWORK:=test-openam}"
