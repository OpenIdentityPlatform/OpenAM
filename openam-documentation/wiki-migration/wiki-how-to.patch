-        }
-        this.options = options;
-        bundle = amCache.getResBundle(amAuthSampleAuth, getLoginLocale());
-    }
-
-    @Override
-    public int process(Callback[] callbacks, int state) throws LoginException {
-
-        if (debug.messageEnabled()) {
